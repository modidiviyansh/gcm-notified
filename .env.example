# GCM Notified — environment variables.
# In production these are set in Coolify (never commit real values).
# "CHANGE_ME" counts as not set; the app refuses to start while a required value is CHANGE_ME.

# ---- required ----
# Postgres role/schema created by db/00_create_schema.sql
DATABASE_URL=postgres://gcm_notified:CHANGE_ME@HOST:5432/postgres
DATABASE_SSL=false

# Dashboard login (single admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
# Signs the login cookie — openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# WhatsApp engine (WAHA)
WAHA_URL=https://waha.example.com
WAHA_API_KEY=CHANGE_ME
# Signs WAHA → app webhooks (HMAC-SHA512) — openssl rand -hex 32
WEBHOOK_SECRET=CHANGE_ME

# Public address of this app (WAHA sends webhooks to $PUBLIC_URL/api/webhooks/waha)
PUBLIC_URL=https://notified.example.com

# ---- optional ----
# Frappe / ERPNext Education (read-only API user) — student sync
FRAPPE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_TIMEZONE=Asia/Kolkata
DATA_DIR=/data
PORT=3000
# false = dry-run: messages are logged, never sent (local testing)
SENDING_ENABLED=true
